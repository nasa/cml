---
# Ignored warnings:
#
# bugprone:
#     bugprone-easily-swappable-parameters:
#         May end up hurting readability in many cases. However, in the future
#         we may want to set the MinimumLength option to a higher number to
#         warn on excessively long argument lists of the same type.
#     bugprone-reserved-identifier:
#         Will be enabled in the future (https://github.com/nasa/cml/issues/87).
#
# clang-analyzer:
#     clang-analyzer-optin.performance.Padding:
#         Can end up being detrimental by suggesting that certain fields which
#         were grouped together for logical coherence be split apart. It's more
#         important that the data is easy to read than it is to save a few bytes
#         of padding.
#
# misc:
#     To be added in a future pull request
#
# modernize:
#     To be added in a future pull request
#
# performance:
#     performance-enum-size:
#         May enable in the future, but doesn't really buy us anything and might
#         not play well with SWIG.
#
# portability:
#     portability-template-virtual-member-function:
#         Not a concern since we only support GCC.
#
# readability:
#     To be added in a future pull request
#
# Note that rather than ignoring a large number of warnings from other
# categories, we only include selected warnings from categories like google-*
# and cppcoreguidelines-*.
Checks: >
    bugprone-*,
        -bugprone-easily-swappable-parameters,
        -bugprone-reserved-identifier,
    cppcoreguidelines-*coroutines*,
    cppcoreguidelines-avoid-goto,
    cppcoreguidelines-interfaces-global-init,
    cppcoreguidelines-macro-usage,
    cppcoreguidelines-misleading-capture-default-by-value,
    cppcoreguidelines-no-malloc,
    cppcoreguidelines-pro-type-member-init,
    cppcoreguidelines-pro-type-static-cast-downcast,
    cppcoreguidelines-rvalue-reference-param-not-moved,
    clang-*,
        -clang-analyzer-optin.performance.Padding,
    google-build-using-namespace,
    google-global-names-in-headers,
    misc-inclue-cleaner,
    modernize-use-equals-delete,
    portability-*,
        -portability-template-virtual-member-function,
    performance-*,
        -performance-enum-size

WarningsAsErrors: '*'

HeaderFilterRegex: '(^|/)(models|utility)/.*'

CheckOptions:
    - key: misc-include-cleaner.IgnoreHeaders
      value: 'math.h;cmath;' # Only for M_PI. Remove when we go to C++20.
...
