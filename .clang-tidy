# Ignored warnings:
#
# bugprone:
#     bugprone-easily-swappable-parameters:
#         May end up hurting readability in many cases. However, in the future
#         we may want to set the MinimumLength option to a higher number to
#         warn on excessively long argument lists of the same type.
#     bugprone-reserved-identifier:
#         Will be enabled in the future (https://github.com/nasa/cml/issues/87).
#
# clang-analyzer:
#     clang-analyzer-optin.performance.Padding:
#         Can end up being detrimental by suggesting that certain fields which
#         were grouped together for logical coherence be split apart. It's more
#         important that the data is easy to read than it is to save a few bytes
#         of padding.
#
# misc:
#     misc-no-recursion:
#         Recursion is fine.
#     misc-non-private-member-variables-in-classes:
#         Not useful for Trick sims.
#
# modernize:
#     To be added in a future pull request
#
# performance:
#     performance-enum-size:
#         May enable in the future, but doesn't really buy us anything and might
#         not play well with SWIG.
#
# portability:
#     portability-template-virtual-member-function:
#         Not a concern since we only support GCC.
#
# readability:
#     readability-avoid-const-params-in-decls:
#         Doesn't actually matter.
#     readability-convert-member-functions-to-static:
#         We may want to re-enable this in the future but for now it really
#         just adds confusion.
#     readability-else-after-return:
#         We'll rely on manual review for most of these cases, but it shouldn't
#         be applied globally as a rule.
#     readability-function-cognitive-complexity:
#         We'll decide manually during code reviews whether there's a problem
#         with a function's cognitive complexity.
#     readability-function-size:
#         We include some autogenerated code for large data sets in CML so we
#         can't really use this one.
#     readability-identifier-length:
#         As a math library it's more important that the code reflects the
#         mathematical formulation of the model rather than arbitrary identifier
#         length restrictions.
#     readability-math-missing-parentheses:
#         Generally doesn't add anything to readability.
#     readability-magic-numbers:
#         Simply not an option for a math library. Will need to manually review
#         for genuine magic numbers vs. constants used in formulas.
#     readability-uppercase-literal-suffix:
#         Doesn't matter.
#
# Note that rather than ignoring a large number of warnings from other
# categories, we only include selected warnings from categories like google-*
# and cppcoreguidelines-*.
Checks: >
    bugprone-*,
        -bugprone-easily-swappable-parameters,
        -bugprone-reserved-identifier,
    cppcoreguidelines-*coroutines*,
    cppcoreguidelines-avoid-goto,
    cppcoreguidelines-interfaces-global-init,
    cppcoreguidelines-macro-usage,
    cppcoreguidelines-misleading-capture-default-by-value,
    cppcoreguidelines-no-malloc,
    cppcoreguidelines-pro-type-member-init,
    cppcoreguidelines-pro-type-static-cast-downcast,
    cppcoreguidelines-rvalue-reference-param-not-moved,
    clang-*,
        -clang-analyzer-optin.performance.Padding,
    google-build-using-namespace,
    google-global-names-in-headers,
    misc-*,
        -misc-no-recursion,
        -misc-non-private-member-variables-in-classes,
    modernize-use-equals-delete,
    portability-*,
        -portability-template-virtual-member-function,
    performance-*,
        -performance-enum-size,
    readability-*,
        -readability-avoid-const-params-in-decls,
        -readability-convert-member-functions-to-static,
        -readability-else-after-return,
        -readability-function-cognitive-complexity,
        -readability-function-size,
        -readability-identifier-length,
        -readability-math-missing-parentheses,
        -readability-magic-numbers,
        -readability-uppercase-literal-suffix

WarningsAsErrors: '*'

HeaderFilterRegex: '(^|/)(models|utility)/.*'

CheckOptions:
    - key: misc-const-correctness.AnalyzePointers
      value: false  # False positives when returning non-const pointers from a function
    - key: misc-include-cleaner.IgnoreHeaders
      value: 'math.h;cmath;' # Only for M_PI. Remove when we go to C++20.
    - key: readability-inconsistent-declaration-parameter-name.Strict
      value: true
    - key: readability-operators-representation.BinaryOperators
      value: "&&;&=;&;|;~;!;!=;||;|=;^;^="
