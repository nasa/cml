/*****************************************************************************
Vehicle sim object
*****************************************************************************/

##include "jeod/models/dynamics/dyn_body/include/dyn_body.hh"
##include "jeod/models/dynamics/body_action/include/mass_body_init.hh"
##include "jeod/models/dynamics/body_action/include/body_attach_matrix.hh"
##include "jeod/models/dynamics/body_action/include/body_detach.hh"
##include "cml/models/dynamics/state_initialize/state_initialize/include/state_initialize.hh"
##include "cml/models/dynamics/state_overrides/traj_model/include/traj_model.hh"

##include "../../include/shadow_trajectory.hh"

class VehicleSimObject : public Trick::SimObject {
 protected:
  jeod::DynManager & dyn_manager;
 public:
  jeod::DynBody     parent;
  jeod::DynBody     child;
  jeod::MassBodyInit          mass_init[2];
  jeod::BodyAttachMatrix  attach;
  jeod::BodyDetach        detach;

  StateInitialize       state_initialize;
  TrajModel             traj;

  bool detach_parent_child;

  ShadowTrajectory      shadow;

  VehicleSimObject( const double & dyn_time,
                    jeod::DynManager & dyn_mgr,
                    const jeod::Planet & earth_p)
    :
    dyn_manager (dyn_mgr),
    traj(dyn_time, earth_p, parent),
    detach_parent_child(false),
    shadow(child, traj)
  {
    ("default_data")         traj.subscribe();

    P_ENV ("initialization") child.initialize_model( dyn_manager);
    P_ENV ("initialization") parent.initialize_model( dyn_manager);
    ("initialization") traj.initialize();
    ("initialization") shadow.initialize();

    (1.0, "environment") traj.update();
    (1.0, "environment") shadow.update();

    (100.0, 2.0, "scheduled") activate_separation();
  };
 private:
  void activate_separation()
  {
    // NOTE - must turn on the shadow before turning off the primary traj-model
    shadow.subscribe();
    if (detach_parent_child) {
      detach.active = true;
      traj.unsubscribe();
    }
  }
  VehicleSimObject( const VehicleSimObject&);
  VehicleSimObject & operator= ( const VehicleSimObject&);
};

VehicleSimObject vehicle(jeod_time.time_manager.dyn_time.seconds,
                         dynamics.dyn_manager,
                         earth.planet);


IntegLoop sim_integ_loop (DYNAMICS) dynamics;
